# Telegram — BOT_TOKEN = secondary shop bot; MAIN_BOT_TOKEN = MainBot (optional)
BOT_TOKEN=123456:ABCDEF_your_bot_token
MAIN_BOT_TOKEN=
ADMIN_IDS=123456789,987654321

# 3x-ui panel API (Bearer token from Settings → API Tokens)
XUI_BASE_URL=http://127.0.0.1:2053/panel-339f9622a1708da6
XUI_API_TOKEN=your_api_token_here

# Which inbound IDs to attach new customers to (comma-separated)
# 2=Reality 8443, 3=WS via nginx 443, 4=HTTP 8080, 5=WS-TLS 2083, 6=HTTP-MS 8081, 9=Reality-AMZ 26607
XUI_INBOUND_IDS=2,3,4,5,6,9

# Public endpoints used when rewriting localhost share links
PUBLIC_HOST=shabash.cloudproducts.ir
# Optional override; default is https://PUBLIC_HOST/shop/sub
# SUBSCRIPTION_BASE_URL=https://shabash.cloudproducts.ir/shop/sub
PUBLIC_IP=46.31.79.157
# Optional label on primary-server configs (e.g. ایران)
VPN_PRIMARY_LABEL=

# Extra country servers are added in Admin → Settings → سرورهای کشورها
# Each extra VPS needs its own 3x-ui panel, API token, inbound IDs, and public host/IP.

# Payment instructions shown to buyers (editable later via /admin)
PAYMENT_CARD=6037-****-****-****
PAYMENT_CARD_NAME=نام صاحب کارت
PAYMENT_NOTE=پس از واریز، رسید را در همین چت ارسال کنید.

# Database
DATABASE_URL=sqlite:////opt/3x-ui/vpn-bot-data/shop.db

# Branding
SHOP_NAME=Black Lines VPN
MINIAPP_URL=https://shabash.cloudproducts.ir/shop/
MINIAPP_MENU_TEXT=Open
MINIAPP_SHORT_NAME=shop
API_HOST=127.0.0.1
API_PORT=8105
